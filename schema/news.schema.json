{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "source", "url", "title_original", "lang_original", "country", "tags", "summary"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "type": "string", "format": "date-only" },
    "source": { "type": "string", "pattern": "\\S" },
    "url": { "type": "string", "format": "https-url" },
    "title_original": { "type": "string", "pattern": "\\S", "maxLength": 200 },
    "lang_original": { "type": "string", "format": "language" },
    "country": { "type": "string", "format": "iso-country" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["dnm", "demoras", "residencia", "ciudadania", "refugio", "defensoria", "justicia", "normativa", "otros-paises"] }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["es", "ru", "en"],
      "properties": { "es": { "$ref": "#/definitions/summary" }, "ru": { "$ref": "#/definitions/summary" }, "en": { "$ref": "#/definitions/summary" } }
    }
  },
  "definitions": { "summary": { "type": "string", "pattern": "\\S", "minLength": 40, "maxLength": 320 } }
}
